# Скопируйте в .env.local и заполните.

# База данных Turso. Для локальной разработки достаточно file:local.db.
# В продакшене: libsql://<имя-базы>-<аккаунт>.turso.io и токен из `turso db tokens create`.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Секрет для подписи JWT — случайная строка не короче 32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Первый администратор — создаётся командой `npm run seed:admin`.
ADMIN_NAME=Администратор
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Пароль демо-менеджеров для `npm run seed:demo` (только для локальной базы).
DEMO_USER_PASSWORD=

# Telegram-бот: заявки из сообщений клиентов. Токен выдаёт @BotFather;
# секрет вебхука — случайная строка (A-Z, a-z, 0-9, _ и -, до 256 символов):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Если переменных нет, вебхук отвечает 401 и бот не работает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Часовой пояс, в котором считается «сегодня» для просроченных задач.
APP_TIMEZONE=UTC
